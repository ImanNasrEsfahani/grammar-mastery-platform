{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammar-mastery.local/schemas/stage20-bulk-import-v1.0.0.json",
  "title": "Stage20 Admin Bulk Import Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "mode", "rows"],
  "properties": {
    "schema_version": {"const": "stage20-bulk-import-v1.0.0"},
    "batch_id": {"type": "string", "format": "uuid"},
    "mode": {"enum": ["PREVIEW", "COMMIT"]},
    "confirmation_token": {"type": ["string", "null"]},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "allOf": [
          {"$ref": "question_import.schema.json"},
          {
            "type": "object",
            "properties": {"status": {"const": "DRAFT"}}
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "COMMIT"}}},
      "then": {
        "required": ["confirmation_token"],
        "properties": {"confirmation_token": {"type": "string", "minLength": 16}}
      }
    }
  ]
}
