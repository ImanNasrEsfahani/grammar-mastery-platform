{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammar-mastery.local/schemas/stage21-idempotency-record-v1.0.0.json",
  "title": "Stage21 Idempotency Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "principal_id",
    "operation_id",
    "idempotency_key",
    "request_hash",
    "state",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "contract_version": {"const": "api-idempotency-v1.0.0"},
    "principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation_id": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]{2,79}$"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["IN_PROGRESS", "COMPLETED", "FAILED"]},
    "response_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "response_body": {"type": ["object", "array", "null"]},
    "resource_type": {"type": ["string", "null"], "maxLength": 80},
    "resource_id": {"type": ["string", "null"], "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "COMPLETED"}}},
      "then": {"required": ["response_status", "response_body", "completed_at"]}
    }
  ]
}
