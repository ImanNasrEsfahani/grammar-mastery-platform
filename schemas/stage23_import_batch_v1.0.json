{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammar-mastery.local/schemas/stage23-import-batch-v1.0.0.json",
  "title": "Stage 23 Import Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "pipeline_version", "schema_version", "file_name", "file_type", "raw_sha256", "raw_size_bytes", "status", "created_by", "created_at", "row_count", "valid_count", "invalid_count", "duplicate_count", "semantic_review_count", "committed_count"],
  "properties": {
    "batch_id": {"type": "string", "format": "uuid"},
    "pipeline_version": {"const": "stage23-import-pipeline-v1.0.0"},
    "schema_version": {"const": "question-import-schema-v0.9.0"},
    "file_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "file_type": {"enum": ["CSV", "XLSX"]},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_size_bytes": {"type": "integer", "minimum": 1, "maximum": 20971520},
    "status": {"enum": ["UPLOADED", "PARSED", "PREVIEW_READY", "COMMITTED", "FAILED", "ROLLED_BACK"]},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "parsed_at": {"type": ["string", "null"], "format": "date-time"},
    "previewed_at": {"type": ["string", "null"], "format": "date-time"},
    "committed_at": {"type": ["string", "null"], "format": "date-time"},
    "rolled_back_at": {"type": ["string", "null"], "format": "date-time"},
    "failed_at": {"type": ["string", "null"], "format": "date-time"},
    "row_count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "valid_count": {"type": "integer", "minimum": 0},
    "invalid_count": {"type": "integer", "minimum": 0},
    "duplicate_count": {"type": "integer", "minimum": 0},
    "semantic_review_count": {"type": "integer", "minimum": 0},
    "committed_count": {"type": "integer", "minimum": 0},
    "preview_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "failure_code": {"type": ["string", "null"], "pattern": "^[A-Z0-9_]+$"},
    "rollback_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
  }
}
