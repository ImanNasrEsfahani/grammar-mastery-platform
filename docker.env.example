# Copy this file to .env.docker and replace every CHANGE_ME value.
# Never commit .env.docker. The repository's existing .gitignore already ignores .env.*.

APP_ENV=staging

# Host-side port bindings. Keep 127.0.0.1 when a host reverse proxy (Nginx/Caddy)
# terminates HTTPS. Change to 0.0.0.0 only for deliberate direct testing.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# Django runtime.
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_DB_SSLMODE=prefer
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# PostgreSQL container. Use a long random password and do not reuse it elsewhere.
POSTGRES_DB=grammar_mastery
POSTGRES_USER=grammar_mastery
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD

# Next.js server-only Django origin. This is intentionally Docker-internal.
DJANGO_API_BASE_URL=http://backend:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=fa
