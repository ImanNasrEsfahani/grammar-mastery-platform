# Keep unrelated data out of the Docker build context, but allow the canonical
# reference and Question Bank inputs required by the default migration pipeline.
data/*
!data/knowledge/
!data/taxonomy/
!data/planning/

data/knowledge/*
!data/knowledge/stage1_lessons_v1.0.csv
!data/knowledge/stage1_subtopics_v1.0.csv

data/taxonomy/*
